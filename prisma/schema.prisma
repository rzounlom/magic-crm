// MagicCRM tenant foundation plus authorization, inquiries, finite-resource schedule, and confirmed Bookings.
// Catalog products and outbound email delivery are not implemented yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One MagicCRM client. Generations Adventureplex is tenant data, never a schema special case.
model Organization {
  id                  String   @id @default(cuid(2))
  clerkOrganizationId String?  @unique
  name                String
  slug                String   @unique
  /// IANA timezone identifier. Required; no tenant-specific schema default.
  timezone            String
  /// ISO 4217 currency code. Monetary amounts must never use floating-point types.
  currency            String   @db.VarChar(3)
  /// PROVISIONING | AWAITING_ADMIN | ACTIVE | FAILED. Session-provisioned tenants stay ACTIVE.
  onboardingStatus    String   @default("ACTIVE") @db.VarChar(32)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  locations           Location[]
  userProfiles        UserProfile[]
  securityGroups      SecurityGroup[]
  auditLogs           AuditLog[]
  teamInvitations     TeamInvitation[]
  inquiries           Inquiry[]
  conversations       Conversation[]
  conversationMessages ConversationMessage[]
  salesKnowledgeItems SalesKnowledgeItem[]
  eventPlanRecommendations EventPlanRecommendation[]
  resourceTypes       ResourceType[]
  resources           Resource[]
  knowledgeResourceRequirements KnowledgeResourceRequirement[]
  resourceReservations ResourceReservation[]
  communicationEvents CommunicationEvent[]
  bookings            Booking[]
  bookingLineItems    BookingLineItem[]
  bookingSequences    OrganizationBookingSequence[]
  aiUsage             AiUsage[]

  @@index([onboardingStatus])
  @@map("organizations")
}

/// A physical or operational site belonging to exactly one organization.
model Location {
  id             String   @id @default(cuid(2))
  organizationId String
  name           String
  slug           String
  timezone       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultForUserProfiles UserProfile[]
  inquiries              Inquiry[]
  salesKnowledgeItems    SalesKnowledgeItem[]
  resourceTypes          ResourceType[]
  resources              Resource[]
  bookings               Booking[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, active])
  @@map("locations")
}

/// Tenant employee membership. One Clerk user may have one profile per organization.
/// Employee authorization uses Security Groups — this model has no role field.
/// firstName/email/avatarUrl are a Clerk identity display snapshot, not authorization.
model UserProfile {
  id                String   @id @default(cuid(2))
  clerkUserId       String
  organizationId    String
  defaultLocationId String?
  firstName         String?  @db.VarChar(80)
  lastName          String?  @db.VarChar(80)
  displayName       String?  @db.VarChar(160)
  /// Login/work email snapshot. Not unique: one Clerk user may belong to many tenants.
  email             String?  @db.VarChar(254)
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Same-tenant default location. ON DELETE RESTRICT matches Prisma and PostgreSQL.
  /// A future location-delete service must clear defaultLocationId in the same transaction.
  defaultLocation      Location?             @relation(fields: [organizationId, defaultLocationId], references: [organizationId, id], onDelete: Restrict)
  securityGroupMembers SecurityGroupMember[]
  invitationsSent      TeamInvitation[]      @relation("TeamInvitationsSent")
  assignedInquiries    Inquiry[]             @relation("InquiryAssignee")
  confirmedBookings    Booking[]             @relation("BookingConfirmedBy")
  resourceReservations ResourceReservation[] @relation("ResourceReservationCreatedBy")

  @@unique([organizationId, id])
  @@unique([organizationId, clerkUserId])
  @@index([organizationId])
  @@index([organizationId, defaultLocationId])
  @@index([clerkUserId])
  @@map("user_profiles")
}

/// Platform-owned permission catalog. Tenants cannot create keys.
model PermissionDefinition {
  id          String   @id @default(cuid(2))
  key         String   @unique @db.VarChar(80)
  module      String   @db.VarChar(40)
  name        String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupPermissions SecurityGroupPermission[]

  @@index([module])
  @@index([active])
  @@map("permission_definitions")
}

/// Tenant-defined grouping of platform permissions.
model SecurityGroup {
  id             String   @id @default(cuid(2))
  organizationId String
  name           String   @db.VarChar(80)
  description    String?
  isSystem       Boolean  @default(false)
  /// Stable template key such as "administrators". Null for custom groups.
  systemKey      String?  @db.VarChar(64)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions          SecurityGroupPermission[]
  members              SecurityGroupMember[]
  invitationAssignments TeamInvitationSecurityGroup[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId])
  @@index([organizationId, isSystem])
  @@map("security_groups")
}

/// Permission assigned to a tenant security group.
model SecurityGroupPermission {
  id                     String @id @default(cuid(2))
  organizationId         String
  securityGroupId        String
  permissionDefinitionId String

  securityGroup        SecurityGroup        @relation(fields: [organizationId, securityGroupId], references: [organizationId, id], onDelete: Cascade)
  permissionDefinition PermissionDefinition @relation(fields: [permissionDefinitionId], references: [id], onDelete: Restrict)

  @@unique([securityGroupId, permissionDefinitionId])
  @@index([organizationId])
  @@index([permissionDefinitionId])
  @@map("security_group_permissions")
}

/// Same-tenant membership: UserProfile and SecurityGroup share organizationId.
model SecurityGroupMember {
  id              String   @id @default(cuid(2))
  organizationId  String
  securityGroupId String
  userProfileId   String
  createdAt       DateTime @default(now())

  securityGroup SecurityGroup @relation(fields: [organizationId, securityGroupId], references: [organizationId, id], onDelete: Cascade)
  userProfile   UserProfile   @relation(fields: [organizationId, userProfileId], references: [organizationId, id], onDelete: Cascade)

  @@unique([securityGroupId, userProfileId])
  @@index([organizationId])
  @@index([userProfileId])
  @@map("security_group_members")
}

/// Append-only tenant audit trail. No tenant edit/delete path.
model AuditLog {
  id                 String   @id @default(cuid(2))
  organizationId     String
  actorUserProfileId String?
  action             String   @db.VarChar(80)
  resourceType       String   @db.VarChar(80)
  resourceId         String?
  metadata           Json?
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}

/// MagicCRM invitation intent. Clerk owns the actual Organization invitation.
model TeamInvitation {
  id                            String    @id @default(cuid(2))
  organizationId                String
  clerkOrganizationInvitationId String    @unique
  email                         String    @db.VarChar(254)
  emailNormalized               String    @db.VarChar(254)
  invitedByUserProfileId        String?
  status                        String    @db.VarChar(24)
  /// When true, acceptance must place the user in Administrators.
  firstAdminIntent              Boolean   @default(false)
  expiresAt                     DateTime?
  acceptedAt                    DateTime?
  revokedAt                     DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    UserProfile?                   @relation("TeamInvitationsSent", fields: [organizationId, invitedByUserProfileId], references: [organizationId, id], onDelete: Restrict)
  queuedGroups TeamInvitationSecurityGroup[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, emailNormalized, status])
  @@map("team_invitations")
}

/// Queued Security Groups applied after the invitee’s first UserProfile exists.
model TeamInvitationSecurityGroup {
  id               String @id @default(cuid(2))
  organizationId   String
  teamInvitationId String
  securityGroupId  String

  invitation    TeamInvitation @relation(fields: [organizationId, teamInvitationId], references: [organizationId, id], onDelete: Cascade)
  securityGroup SecurityGroup  @relation(fields: [organizationId, securityGroupId], references: [organizationId, id], onDelete: Restrict)

  @@unique([teamInvitationId, securityGroupId])
  @@index([organizationId])
  @@map("team_invitation_security_groups")
}

/// Customer event inquiry. CRM lead; Booking is the confirmed operational record.
model Inquiry {
  id                       String    @id @default(cuid(2))
  organizationId           String
  locationId               String?
  status                   String    @db.VarChar(32)
  source                   String    @db.VarChar(32)
  customerFirstName        String?   @db.VarChar(80)
  customerLastName         String?   @db.VarChar(80)
  customerGroupName        String?   @db.VarChar(160)
  customerEmail            String    @db.VarChar(254)
  customerEmailNormalized  String    @db.VarChar(254)
  customerPhone            String?   @db.VarChar(32)
  eventType                String?   @db.VarChar(80)
  desiredDate              DateTime? @db.Date
  desiredStartTime         String?   @db.VarChar(16)
  guestCount               Int?
  childGuestCount          Int?
  adultGuestCount          Int?
  guestMix                 String?   @db.VarChar(32)
  desiredDurationMinutes   Int?
  /// Integer minor units (cents) when present. Not floating-point.
  budgetMin                Int?
  budgetMax                Int?
  occasion                 String?   @db.VarChar(120)
  eventGoal                String?   @db.VarChar(80)
  diningPreference         String?   @db.VarChar(80)
  spacePreference          String?   @db.VarChar(32)
  /// Tenant sales-knowledge item ids the customer selected. Empty array when none.
  attractionInterestIds    Json?
  customerNotes            String?   @db.VarChar(2000)
  internalSummary          String?   @db.VarChar(4000)
  employeeInternalNotes    String?   @db.VarChar(4000)
  assignedUserProfileId    String?
  aiHandlingEnabled        Boolean   @default(true)
  humanHandoffRequestedAt  DateTime?
  humanHandoffReason       String?   @db.VarChar(500)
  recommendationsGeneratedAt DateTime?
  recommendationsViewedAt  DateTime?
  selectedEventPlanId      String?
  customerSelectedAt       DateTime?
  /// READY_FOR_LIVE_AGENT | AGENT_WORKING | HOLD_PLACED | READY_TO_FINALIZE. Inquiry.status stays READY_FOR_HUMAN.
  workflowStage            String?   @db.VarChar(32)
  assignedAt               DateTime?
  customerContactedAt      DateTime?
  agentWorkingPlanId       String?
  readyToFinalizeAt        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location      Location?       @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  assignedUser  UserProfile?    @relation("InquiryAssignee", fields: [organizationId, assignedUserProfileId], references: [organizationId, id], onDelete: Restrict)
  conversations Conversation[]
  eventPlanRecommendations EventPlanRecommendation[]
  resourceReservations ResourceReservation[]
  communicationEvents  CommunicationEvent[]
  bookings             Booking[]
  aiUsage              AiUsage[]

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerEmailNormalized])
  @@index([organizationId, selectedEventPlanId])
  @@index([organizationId, customerSelectedAt])
  @@index([organizationId, workflowStage])
  @@map("inquiries")
}

/// Tenant-scoped recommended event plan tied to one inquiry. Not a reservation.
model EventPlanRecommendation {
  id                    String   @id @default(cuid(2))
  organizationId        String
  inquiryId             String
  tier                  String   @db.VarChar(32)
  title                 String   @db.VarChar(120)
  sortOrder             Int
  estimatedTotalCents   Int?
  currency              String   @db.VarChar(3)
  guestCount            Int?
  durationMinutes       Int?
  customerFacingReason  String   @db.VarChar(1000)
  availabilityValidated Boolean  @default(false)
  availabilityNote      String?  @db.VarChar(500)
  /// NOT_VALIDATED | AVAILABLE | NEEDS_ADJUSTMENT | AVAILABILITY_CHANGED — plan-level, not Inquiry.status.
  availabilityStatus    String   @default("NOT_VALIDATED") @db.VarChar(32)
  availabilityCheckedAt DateTime?
  /// RECOMMENDATION | AGENT_WORKING. Customer-selected rows stay RECOMMENDATION and are not overwritten by staff edits.
  kind                  String   @default("RECOMMENDATION") @db.VarChar(24)
  payload               Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inquiry      Inquiry      @relation(fields: [organizationId, inquiryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, inquiryId, kind, tier], map: "event_plan_recommendations_org_inquiry_kind_tier_key")
  @@index([organizationId, inquiryId])
  @@map("event_plan_recommendations")
}

/// Customer conversation thread. One inquiry may have multiple channels later.
model Conversation {
  id              String    @id @default(cuid(2))
  organizationId  String
  inquiryId       String
  channel         String    @db.VarChar(16)
  publicTokenHash String    @unique
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inquiry      Inquiry               @relation(fields: [organizationId, inquiryId], references: [organizationId, id], onDelete: Restrict)
  messages     ConversationMessage[]

  @@unique([organizationId, id])
  @@index([organizationId, inquiryId])
  @@map("conversations")
}

/// Durable conversation history. MagicCRM is the source of truth, not OpenAI.
model ConversationMessage {
  id                 String   @id @default(cuid(2))
  organizationId     String
  conversationId     String
  direction          String   @db.VarChar(16)
  senderType         String   @db.VarChar(16)
  content            String   @db.VarChar(8000)
  clientSubmissionId String?  @db.VarChar(80)
  aiModel            String?  @db.VarChar(80)
  aiResponseId       String?  @db.VarChar(120)
  metadata           Json?
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([conversationId, clientSubmissionId])
  @@index([organizationId, conversationId, createdAt])
  @@map("conversation_messages")
}

/// Temporary AI-ready sales knowledge. Phase 3 Catalog may replace or back this.
model SalesKnowledgeItem {
  id                   String   @id @default(cuid(2))
  organizationId       String
  locationId           String?
  type                 String   @db.VarChar(32)
  name                 String   @db.VarChar(160)
  shortDescription     String   @db.VarChar(280)
  details              String   @db.VarChar(4000)
  priceText            String?  @db.VarChar(160)
  durationMinutes      Int?
  minGuests            Int?
  maxGuests            Int?
  waiverRequired       Boolean  @default(false)
  active               Boolean  @default(true)
  salesNotes           String?  @db.VarChar(2000)
  customerFacingNotes  String?  @db.VarChar(2000)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  resourceRequirements KnowledgeResourceRequirement[]

  @@unique([organizationId, id])
  @@index([organizationId, active, type])
  @@map("sales_knowledge_items")
}

/// Tenant-configurable finite inventory category (bowling lanes, rooms, etc.).
model ResourceType {
  id                      String   @id @default(cuid(2))
  organizationId          String
  locationId              String?
  name                    String   @db.VarChar(120)
  slug                    String   @db.VarChar(80)
  /// SLOTTED (fixed increments) or CONTINUOUS.
  schedulingMode          String   @default("SLOTTED") @db.VarChar(24)
  slotMinutes             Int      @default(30)
  defaultDurationMinutes  Int?
  bufferBeforeMinutes     Int      @default(0)
  bufferAfterMinutes      Int      @default(0)
  /// False until an Admin has created numbered Resource rows for this type.
  inventoryConfigured     Boolean  @default(false)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  resources    Resource[]
  requirements KnowledgeResourceRequirement[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId, active])
  @@map("resource_types")
}

/// One numbered finite unit (Bowling Lane 1). Capacity is optional and must not be invented.
model Resource {
  id             String   @id @default(cuid(2))
  organizationId String
  resourceTypeId String
  locationId     String?
  name           String   @db.VarChar(120)
  displayOrder   Int
  capacity       Int?
  active         Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resourceType ResourceType @relation(fields: [organizationId, resourceTypeId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  reservations ResourceReservation[]

  @@unique([organizationId, id])
  @@unique([organizationId, resourceTypeId, displayOrder])
  @@index([organizationId, resourceTypeId, active])
  @@map("resources")
}

/// How a sales-knowledge offering consumes a finite resource type. Missing ratios stay unconfigured.
model KnowledgeResourceRequirement {
  id                         String   @id @default(cuid(2))
  organizationId             String
  salesKnowledgeItemId       String
  resourceTypeId             String
  /// FIXED | PER_GUESTS | UNKNOWN
  quantityRule               String   @db.VarChar(24)
  quantity                   Int?
  guestsPerUnit              Int?
  durationMinutes            Int?
  requiresStaffConfiguration Boolean  @default(false)
  notes                      String?  @db.VarChar(500)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesKnowledgeItem SalesKnowledgeItem @relation(fields: [organizationId, salesKnowledgeItemId], references: [organizationId, id], onDelete: Restrict)
  resourceType       ResourceType       @relation(fields: [organizationId, resourceTypeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, salesKnowledgeItemId, resourceTypeId])
  @@index([organizationId, resourceTypeId])
  @@map("knowledge_resource_requirements")
}

/// Occupies a finite resource. AVAILABLE is the absence of an active HOLD or BOOKED row — not a stored status.
model ResourceReservation {
  id                    String    @id @default(cuid(2))
  organizationId        String
  resourceId            String
  /// HOLD | BOOKED
  status                String    @db.VarChar(16)
  /// Event-local calendar date.
  slotDate              DateTime  @db.Date
  /// Minutes from local midnight; endMinute may exceed 1440 if the window crosses midnight.
  startMinute           Int
  endMinute             Int
  inquiryId             String?
  bookingId             String?
  /// INQUIRY | BOOKING | MANUAL
  sourceType            String    @db.VarChar(24)
  expiresAt             DateTime?
  reason                String?   @db.VarChar(240)
  createdByUserProfileId String?
  releasedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resource     Resource      @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Restrict)
  inquiry      Inquiry?      @relation(fields: [organizationId, inquiryId], references: [organizationId, id], onDelete: Restrict)
  booking      Booking?      @relation(fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict)
  createdBy    UserProfile?  @relation("ResourceReservationCreatedBy", fields: [organizationId, createdByUserProfileId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, resourceId, slotDate])
  @@index([organizationId, inquiryId])
  @@index([organizationId, bookingId])
  @@index([organizationId, status, releasedAt])
  @@map("resource_reservations")
}

/// Outbound communication log. Rows may be SKIPPED when no provider is configured — that is not a send.
model CommunicationEvent {
  id                 String    @id @default(cuid(2))
  organizationId     String
  channel            String    @db.VarChar(16)
  kind               String    @db.VarChar(64)
  status             String    @db.VarChar(24)
  skipReason         String?   @db.VarChar(80)
  toAddress          String?   @db.VarChar(254)
  subject            String?   @db.VarChar(200)
  inquiryId          String?
  bookingId          String?
  providerMessageId  String?   @db.VarChar(160)
  payload            Json?
  sentAt             DateTime?
  createdAt          DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inquiry      Inquiry?     @relation(fields: [organizationId, inquiryId], references: [organizationId, id], onDelete: Restrict)
  booking      Booking?     @relation(fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, inquiryId])
  @@index([organizationId, bookingId])
  @@index([organizationId, kind, status])
  @@map("communication_events")
}

/// Tenant-year counter for human-readable booking numbers. Not a public ID.
model OrganizationBookingSequence {
  organizationId String
  year           Int
  lastValue      Int
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, year])
  @@map("organization_booking_sequences")
}

/// Confirmed event. Authoritative after Confirm Booking. Inquiry remains sales history.
model Booking {
  id                       String    @id @default(cuid(2))
  organizationId           String
  inquiryId                String
  locationId               String?
  bookingNumber            String    @db.VarChar(32)
  /// CONFIRMED | CANCELLED | COMPLETED. This pass uses CONFIRMED.
  status                   String    @db.VarChar(24)
  eventDate                DateTime  @db.Date
  startTime                String    @db.VarChar(16)
  endTime                  String    @db.VarChar(16)
  startMinute              Int
  endMinute                Int
  guestCount               Int
  eventType                String?   @db.VarChar(80)
  eventGoal                String?   @db.VarChar(80)
  diningLabel              String?   @db.VarChar(160)
  subtotalCents            Int
  taxCents                 Int       @default(0)
  totalCents               Int
  currency                 String    @db.VarChar(3)
  customerGroupName        String?   @db.VarChar(160)
  customerFirstName        String?   @db.VarChar(80)
  customerLastName         String?   @db.VarChar(80)
  customerEmail            String    @db.VarChar(254)
  customerPhone            String?   @db.VarChar(32)
  customerNotes            String?   @db.VarChar(2000)
  internalNotes            String?   @db.VarChar(4000)
  confirmedByUserProfileId String
  confirmedAt              DateTime
  selectedEventPlanId      String?
  agentWorkingPlanId       String?
  /// Snapshot of the Current Agent Version payload at confirmation.
  payload                  Json
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inquiry      Inquiry          @relation(fields: [organizationId, inquiryId], references: [organizationId, id], onDelete: Restrict)
  location     Location?        @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  confirmedBy  UserProfile      @relation("BookingConfirmedBy", fields: [organizationId, confirmedByUserProfileId], references: [organizationId, id], onDelete: Restrict)
  lineItems    BookingLineItem[]
  reservations ResourceReservation[]
  communicationEvents CommunicationEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, inquiryId])
  @@unique([organizationId, bookingNumber])
  @@index([organizationId, eventDate])
  @@index([organizationId, status, eventDate])
  @@map("bookings")
}

/// Snapshotted confirmed line item. Prices do not change with later catalog edits.
model BookingLineItem {
  id               String  @id @default(cuid(2))
  organizationId   String
  bookingId        String
  /// ACTIVITY | DINING | SPACE
  kind             String  @db.VarChar(24)
  knowledgeItemId  String?
  name             String  @db.VarChar(160)
  quantity         Int     @default(1)
  unitPriceCents   Int
  totalCents       Int
  startTime        String? @db.VarChar(16)
  endTime          String? @db.VarChar(16)
  sortOrder        Int
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking      Booking      @relation(fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, bookingId])
  @@map("booking_line_items")
}

/// Tenant-scoped AI usage metadata for later pricing. Not billing.
model AiUsage {
  id             String   @id @default(cuid(2))
  organizationId String
  inquiryId      String?
  conversationId String?
  model          String   @db.VarChar(80)
  responseId     String?  @db.VarChar(120)
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  latencyMs      Int?
  success        Boolean
  errorCode      String?  @db.VarChar(80)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inquiry      Inquiry?     @relation(fields: [organizationId, inquiryId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("ai_usage")
}
