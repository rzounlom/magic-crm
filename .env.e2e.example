# MagicCRM Playwright E2E — Clerk DEVELOPMENT instance only.
# Copy to .env.e2e (gitignored). Never commit real values.
# Do not point these at Production Clerk (pk_live_ / sk_live_).

# Optional overrides (defaults use synthetic +clerk_test addresses):
# E2E_CLERK_ADMIN_EMAIL=e2e.admin+clerk_test@example.com
# E2E_CLERK_EVENT_SALES_EMAIL=e2e.event-sales+clerk_test@example.com
# E2E_CLERK_FRONT_DESK_EMAIL=e2e.front-desk+clerk_test@example.com

# Org under test (default magiccrm-test-center-b)
# E2E_ORG_SLUG=magiccrm-test-center-b

# Playwright
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_PUBLIC_ORG_SLUG=magiccrm-test-center-b

# Clerk keys are read from .env / .env.local (TEST keys required):
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: pre-fetched testing token (normally created by clerkSetup)
# CLERK_TESTING_TOKEN=
