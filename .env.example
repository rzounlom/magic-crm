# MagicCRM environment placeholders
#
# None of these services are configured in the repository foundation task.
# Values must be supplied later, when each integration is actually introduced.
# Do not put real secrets in this file.

# PostgreSQL connection string (future: Neon)
DATABASE_URL=

# Clerk authentication (server-only secret — never expose as NEXT_PUBLIC_*)
CLERK_SECRET_KEY=

# Clerk publishable key (browser-safe by design)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stripe payments (server-only secret — never expose as NEXT_PUBLIC_*)
STRIPE_SECRET_KEY=

# Stripe publishable key (browser-safe by design)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenAI (server-only secret — never expose as NEXT_PUBLIC_*)
OPENAI_API_KEY=

# Upstash QStash (server-only secret — never expose as NEXT_PUBLIC_*)
QSTASH_TOKEN=
