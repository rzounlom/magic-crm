# MagicCRM environment placeholders
#
# DATABASE_URL and DIRECT_URL are required for Phase 1 database work.
# Other services remain unconfigured. Do not put real secrets in this file.

# Neon pooled connection used by the Next.js application at runtime.
# Example shape only — never commit a real hostname, user, or password.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DATABASE_URL=

# Neon direct (unpooled) connection used by Prisma CLI for migrations,
# introspection, and Prisma Studio. Not used by the application runtime.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL=

# Canonical public origin of this MagicCRM deployment. Used as the Clerk
# Organization invitation return URL. Not a secret. No trailing path.
# Development:
APP_URL=http://localhost:3000
# Production / Vercel: set this to the deployed https origin, for example
# APP_URL=https://your-app.example.com

# Clerk authentication (server-only secret — never expose as NEXT_PUBLIC_*)
CLERK_SECRET_KEY=

# Clerk publishable key (browser-safe by design)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Stripe payments (server-only secret — never expose as NEXT_PUBLIC_*)
# Not configured in this phase.
STRIPE_SECRET_KEY=

# Stripe publishable key (browser-safe by design)
# Not configured in this phase.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenAI (server-only secret — never expose as NEXT_PUBLIC_*)
# Not configured in this phase.
OPENAI_API_KEY=

# Upstash QStash (server-only secret — never expose as NEXT_PUBLIC_*)
# Not configured in this phase.
QSTASH_TOKEN=
