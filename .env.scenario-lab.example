# MagicCRM Scenario Lab — isolated local / future Vercel TEST deployment
#
# Copy to .env.scenario-lab.local (gitignored) and fill in values.
# Do NOT put Scenario Lab URLs into .env, .env.local, or .env.test.
#
# Neon: use the dedicated `scenario_lab` branch connections only.
# Database name alone (neondb) is NOT enough — the Neon endpoint must be the lab branch.

MAGICCRM_DEPLOYMENT_KIND=scenario_lab_test
SCENARIO_LAB_ENABLED=true

# Pooled connection for the Scenario Lab Neon branch (runtime / Next.js)
DATABASE_URL=

# Direct (unpooled) connection for Prisma migrate deploy against Scenario Lab only
DIRECT_URL=

# Must match the provisioned database_environment_identity.token (min 16 chars).
# Generate locally, e.g. openssl rand -hex 24 — do not reuse DEV/TEST tokens.
MAGICCRM_DATABASE_ENVIRONMENT_TOKEN=

# Exactly two distinct Clerk TEST user IDs (user_…)
SCENARIO_LAB_ALLOWED_CLERK_USER_IDS=

# Trusted Clerk TEST organization ID (org_…)
SCENARIO_LAB_ORG_ID=

# Clerk TEST keys for this private lab (sk_test_ / pk_test_)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

APP_URL=http://localhost:3000

# Leave outbound providers unset for private QA.
# OPENAI_API_KEY=
# QSTASH_TOKEN=
