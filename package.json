{
  "name": "magic-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for fun centers — booking, CRM, and AI-assisted event sales.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:watch": "vitest --config vitest.config.mts",
    "test:db:prepare": "node scripts/prepare-test-db.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:sync-auth": "tsx --tsconfig tsconfig.json scripts/sync-auth-reference-data.ts",
    "auth:bootstrap-admin": "tsx --tsconfig tsconfig.json scripts/bootstrap-administrator.ts",
    "tenant:create": "tsx --tsconfig tsconfig.json scripts/create-client-tenant.ts",
    "tenant:seed-sales-knowledge": "tsx --tsconfig tsconfig.json scripts/seed-dev-sales-knowledge.ts",
    "tenant:import-sales-knowledge": "tsx --tsconfig tsconfig.json scripts/seed-dev-sales-knowledge.ts",
    "tenant:sync-resource-types": "tsx --tsconfig tsconfig.json scripts/sync-tenant-resource-types.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/backend": "3.16.13",
    "@clerk/nextjs": "7.8.3",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.3",
    "openai": "6.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.21.0",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
