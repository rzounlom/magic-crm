{
  "name": "magic-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for fun centers — booking, CRM, and AI-assisted event sales.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public-intake.smoke.spec.ts tests/e2e/public-intake.journey.spec.ts tests/e2e/public-token.smoke.spec.ts tests/e2e/public-a11y.smoke.spec.ts tests/e2e/marketing-home.spec.ts tests/e2e/auth-transition.smoke.spec.ts",
    "test:e2e:auth1": "playwright test tests/e2e/auth-transition.smoke.spec.ts --project=chromium-desktop",
    "test:e2e:staff": "playwright test --grep @staff --project=chromium-desktop",
    "test:e2e:staff:all-viewports": "playwright test --grep @staff",
    "test:e2e:staff:headed": "playwright test --grep @staff --headed --project=chromium-desktop",
    "test:e2e:staff:ui": "playwright test --grep @staff --ui --project=chromium-desktop",
    "test:e2e:staff:auth": "node scripts/r3-bootstrap-staff-auth.mjs",
    "test:e2e:staff:auth:verify": "node scripts/r3-verify-staff-auth.mjs",
    "test:e2e:staff:fixture": "tsx --tsconfig tsconfig.json scripts/r3-create-staff-browser-fixture.ts",
    "test:e2e:staff:r4-evidence": "node scripts/r4-capture-staff-evidence.mjs",
    "test:e2e:staff:r5-venue": "tsx --tsconfig tsconfig.json scripts/r5-prepare-test-venue.ts",
    "test:e2e:staff:r5-fixture": "tsx --tsconfig tsconfig.json scripts/r5-create-lifecycle-fixture.ts",
    "test:e2e:staff:r5-nav-evidence": "node scripts/r5-capture-nav-evidence.mjs",
    "test:e2e:staff:r6-nav-evidence": "node scripts/r6-capture-nav-evidence.mjs",
    "test:e2e:staff:lifecycle": "playwright test tests/e2e/staff.lifecycle.spec.ts --project=chromium-desktop",
    "test:e2e:staff:r7-fixture": "tsx --tsconfig tsconfig.json scripts/r7-create-conflict-fixture.ts",
    "test:e2e:staff:r7-conflict": "playwright test tests/e2e/staff.conflict.spec.ts --project=chromium-desktop",
    "test:e2e:staff:r7-evidence": "node scripts/r7-capture-state-evidence.mjs",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest --config vitest.config.mts",

    "test:db:prepare": "node scripts/prepare-test-db.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "node scripts/apply-migrations.mjs dev",
    "db:deploy": "node scripts/apply-migrations.mjs deploy",
    "db:studio": "prisma studio",
    "db:sync-auth": "tsx --tsconfig tsconfig.json scripts/sync-auth-reference-data.ts",
    "auth:bootstrap-admin": "tsx --tsconfig tsconfig.json scripts/bootstrap-administrator.ts",
    "tenant:create": "tsx --tsconfig tsconfig.json scripts/create-client-tenant.ts",
    "tenant:seed-sales-knowledge": "tsx --tsconfig tsconfig.json scripts/seed-dev-sales-knowledge.ts",
    "tenant:import-sales-knowledge": "tsx --tsconfig tsconfig.json scripts/seed-dev-sales-knowledge.ts",
    "tenant:import-booking-catalog": "tsx --tsconfig tsconfig.json scripts/import-booking-catalog.ts",
    "tenant:sync-resource-types": "tsx --tsconfig tsconfig.json scripts/sync-tenant-resource-types.ts",
    "scenario-lab:verify-database": "tsx --tsconfig tsconfig.json scripts/verify-scenario-lab-database.ts",
    "scenario-lab:migrate-deploy": "node scripts/migrate-scenario-lab-database.mjs",
    "scenario-lab:provision-db-identity": "tsx --tsconfig tsconfig.json scripts/provision-scenario-lab-database-identity.ts",
    "scenario-lab:seed": "tsx --tsconfig tsconfig.json scripts/seed-scenario-lab-venue.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/backend": "3.16.13",
    "@clerk/nextjs": "7.8.3",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.3",
    "openai": "6.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.21.0",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
