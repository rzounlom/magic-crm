# Dedicated Neon TEST database only.
# Never copy development or production connection strings into this file.
# The test database must be a different database identity than .env and .env.local.
# A pooler host and a direct host for the same Neon branch count as the same database.
# Copy to .env.test locally. Do not commit .env.test.

MAGICCRM_DATABASE_ROLE=test

# Pooled test connection
DATABASE_URL=

# Direct test connection for Prisma CLI migrate deploy
DIRECT_URL=

# Integration tests inject trusted Clerk auth. Live Clerk keys are not required.
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Canonical origin used when constructing invitation redirect URLs in tests.
APP_URL=http://localhost:3000

# Automated tests inject a fake SalesAgentModel. Do not point tests at live OpenAI.
